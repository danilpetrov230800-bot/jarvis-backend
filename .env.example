# Скопируйте в .env и подставьте ключ выбранного провайдера.
# Достаточно одного ключа — JARVIS сам определит провайдера.

# OpenRouter — много моделей, в том числе с мягкими фильтрами
OPENROUTER_API_KEY=

# OpenAI-совместимый ключ (OpenAI, Groq, Together, локальный прокси)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Groq
GROQ_API_KEY=

# Локальная Ollama (ключ не нужен): http://127.0.0.1:11434/v1
# JARVIS_PROVIDER=ollama
# JARVIS_MODEL=qwen2.5:14b

JARVIS_USER_NAME=Данила
JARVIS_TTS_VOICE=ru-RU-DmitryNeural
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8080
