{
  "name": "nova-assistant",
  "install": "bash scripts/install.sh",
  "terminals": [
    {
      "name": "ollama",
      "command": "ollama serve",
      "description": "Локальный ИИ (Ollama), чтобы не требовались API-ключи."
    },
    {
      "name": "nova",
      "command": "bash scripts/start_nova.sh",
      "description": "Веб-сервер Nova на порту 8000."
    }
  ],
  "ports": [
    {
      "name": "nova",
      "port": 8000
    }
  ]
}
